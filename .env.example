# ─────────────────────────────────────────────────────────────────────────────
# Pluggable Bot — environment variables
# Copy to `.env.local` for local dev, or set them in your Vercel project under
# Settings → Environment Variables. Every deployment-specific value is read from
# the environment; nothing is hard-coded in the source.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────────────
# Get a FREE OpenRouter key at https://openrouter.ai (no credit card required).
# Free tier: 20 req/min, 50 req/day (200 req/day after $10 lifetime spend).
# Without any key the bot runs in demo/mock mode and answers from the
# knowledge base directly.
OPENROUTER_API_KEY=

# Legacy OpenAI key — used only if OPENROUTER_API_KEY is not set.
#OPENAI_API_KEY=

# Model to use (default: openrouter/auto, which picks an available model).
#LLM_MODEL=openrouter/auto

# Override the OpenAI-compatible base URL.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter attribution headers.
#APP_TITLE=Pluggable Bot
#APP_URL=https://github.com/pluggable-bot

# ── Server ───────────────────────────────────────────────────────────────────
# Port for the local dev server (default 8787).
#PORT=8787

# CORS allowed origin (default: allow all).
#CORS_ORIGIN=*

# Public base URL of the API, used to render the demo pages (/ and /mht).
# Leave empty for same-origin relative URLs (correct on Vercel).
# Set it only if the demo pages should call an API on a different origin.
#PUBLIC_API_URL=

# ── Retrieval / knowledge store ───────────────────────────────────────────────
# Directory + file for the on-disk knowledge store (Node dev only).
#DATA_DIR=data
#RAG_TOP_K=5
#CHUNK_SIZE=500
#CHUNK_OVERLAP=50
#MAX_HISTORY=10

# ── Static assets ─────────────────────────────────────────────────────────────
#WIDGET_CACHE_MAX_AGE=3600

# ── Widget (baked into the bundle at build time; can still be overridden per
#    embed via data-* attributes on the <script> tag) ─────────────────────────
#WIDGET_API_URL=
#WIDGET_BOT_NAME=Bot
#WIDGET_PRIMARY_COLOR=#1a1a2e
#WIDGET_POSITION=bottom-right
#WIDGET_CONTEXT_MAX_CHARS=2000
#WIDGET_MAX_HISTORY=10